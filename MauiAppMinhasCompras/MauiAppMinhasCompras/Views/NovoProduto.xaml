<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.NovoProduto"
             Title="Novo Produto">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Salvar" Clicked="ToolbarItem_Clicked"/>
    </ContentPage.ToolbarItems>

    <VerticalStackLayout Spacing="10" Padding="10">
        <Label Text="Descrição do Produto:" />
        <Entry Placeholder="Digite a descrição do produto" x:Name="txt_descricao" />

        <Label Text="Quantidade: " />
        <Entry Placeholder="Digite a quantidade" x:Name="txt_quantidade" Keyboard="Numeric"/>

        <Label Text="Preço Unitário: " />
        <Entry Placeholder="Digite o preço unitário" x:Name="txt_preco" Keyboard="Numeric"/>

        <Label Text="Categoria:" />
        <Picker x:Name="picker_categoria"
         Title="Selecione uma categoria"
         SelectedIndexChanged="Picker_categoria_SelectedIndexChanged">
            <Picker.ItemsSource>
                <x:Array Type="{x:Type x:String}">
                    <x:String>Alimentação</x:String>
                    <x:String>Eletrônicos</x:String>
                    <x:String>Roupas</x:String>
                    <x:String>Higiene</x:String>
                    <x:String>Outros</x:String>
                </x:Array>
            </Picker.ItemsSource>
        </Picker>

    </VerticalStackLayout>
</ContentPage>